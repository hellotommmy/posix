lemma rpders_strong_rows_raw_aseq_terms_closed_legacy_subsetI:
  assumes init: "aseq_termss rs \<subseteq> U"
    and legacy: "\<forall>q \<in> set rs. legacy_rrexp q"
    and zero: "RZERO \<in> U"
    and one: "RONE \<in> U"
