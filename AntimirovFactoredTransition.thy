lemma row_group_deep_nf_rpders_strong_rows_raw:
  assumes "\<forall>r \<in> set rs. row_group_deep_nf r"
    and "p \<in> set (rpders_strong_rows_raw rs s)"
  shows "row_group_deep_nf p"
