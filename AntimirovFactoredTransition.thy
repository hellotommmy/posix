    have size: "rsize_set (deep_simp_frontier_aseq_universe r) \<le>
        2 * (rsize r + 2) ^ 3"
      by (rule rsize_set_deep_simp_frontier_aseq_universe_cubic)
    show ?thesis
      by (rule mult_left_mono[OF size]) simp
