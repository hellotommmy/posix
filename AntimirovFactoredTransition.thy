  assumes stable: "\<And>q. q \<in> set rs \<Longrightarrow> rsimp4_SEQ_atom q RONE = q"
    and each: "\<And>q. q \<in> set rs \<Longrightarrow>
      card (apder_term_frontier_acc q RONE - rfrontier RONE) +
