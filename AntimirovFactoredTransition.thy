      2 * rsize_set (deep_simp_frontier_aseq_universe r)"
    unfolding deep_simp_frontier_fuel_universe_def
    by (rule card_rderiv_fuel_closure_le_rsize_set) simp
  also have "... \<le> 2 * (2 * (rsize r + 2) ^ 3)"
