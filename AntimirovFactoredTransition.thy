qed (auto simp add: rsimp7_SEQ_atom_def)

lemma apder_deep_frontier_delta_acc_RSTAR_subset:
  "apder_deep_frontier_delta_acc (RSTAR r) k \<subseteq>
    apder_dfrontier_delta_acc r (rsimp4_SEQ_atom (RSTAR r) k) \<union>
