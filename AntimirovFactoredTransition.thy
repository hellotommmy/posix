    case True
    then show ?thesis
      using RSEQ.prems by simp
  next
    case False
    then have q_cases: "q \<in> rsubterms r1 \<or> q \<in> rsubterms r2"
      using RSEQ.prems by simp
    show ?thesis
    proof (rule disjE[OF q_cases])
      assume q1: "q \<in> rsubterms r1"
