qed

lemma rsize_eq_1_rrexp_cases:
  assumes "rsize r = 1"
  shows "r = RZERO \<or> r = RONE \<or> (\<exists>c. r = RCHAR c) \<or>
    r = RALTS [] \<or> (\<exists>cs rep. r = RRESIDUE cs rep)"
  using assms
proof (cases r)
  case RZERO
  then show ?thesis by simp
next
  case RONE
  then show ?thesis by simp
next
  case (RCHAR c)
