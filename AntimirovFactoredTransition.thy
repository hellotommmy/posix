  show "card (set ?rows) \<le> ?B"
    using contract U_budget by linarith
  show "rlinear_termss ?rows \<le> ?B"
    using contract U_budget by linarith
  show "rsizes ?rows \<le> ?B"
    using contract U_budget by linarith
