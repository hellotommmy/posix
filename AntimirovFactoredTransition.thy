      "apder_deep_frontier_delta_acc (RALTS rs) k \<subseteq>
        (\<Union>q \<in> set rs. apder_deep_frontier_delta_acc q k)"
    by (rule apder_deep_frontier_delta_acc_RALTS_subset[OF nf k_nf])
