      apder_zw2 (RALTS rs)"
proof -
  let ?A = "\<lambda>q. apder_term_frontier_acc q RONE"
  let ?G = "\<lambda>q. rfrontier (rsimp4_SEQ_atom q RONE)"
  have fronts: "(\<Union>q \<in> set rs. ?G q) = rfrontiers rs"
