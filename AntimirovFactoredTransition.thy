      (apder_term_frontier_acc r1 (rsimp4_SEQ_atom r2 k) \<union>
        apder_term_frontier_acc r2 k) \<le>
      rsize_set (apder_term_frontier_acc r1 (rsimp4_SEQ_atom r2 k)) +
