      rsubterm_closure_extensive)

lemma deep_simp_frontier_subterm_universe_closed:
  assumes "q \<in> deep_simp_frontier_subterm_universe r"
  shows "rsubterms q \<subseteq> deep_simp_frontier_subterm_universe r"
