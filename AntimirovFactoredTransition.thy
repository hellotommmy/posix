  have residue7: "card (row_dlforms (rsimp7_SEQ_atom (RRESIDUE cs rep) k) -
        row_dlforms k) \<le> rsize (RRESIDUE cs rep)"
  proof -
    have "card (row_dlforms (rsimp7_SEQ_atom (RRESIDUE cs rep) k) -
