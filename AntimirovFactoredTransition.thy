lemma apder_deep_frontier_delta_acc_RNTIMES_subset:
  "apder_deep_frontier_delta_acc (RNTIMES r n) k \<subseteq>
    (row_dlforms (rsimp4_SEQ_atom (RNTIMES r n) k) -
