lemma cube_suc_minus_one_le_two_shift3:
  fixes n :: nat
  shows "(n + 1) ^ 3 - 1 \<le> 2 * (n + 3) ^ 3"
proof -
  have "(n + 1) ^ 3 - 1 \<le> (n + 1) ^ 3"
    by simp
  also have "... \<le> (n + 3) ^ 3"
    by (simp add: power_mono)
  also have "... \<le> 2 * (n + 3) ^ 3"
    by simp
  finally show ?thesis .
qed

