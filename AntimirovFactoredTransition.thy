  then show ?thesis
    using assms size_geq1[of r1] by simp
next
  case (RALTS rs)
  have "rsizes rs = 0"
    using assms RALTS by simp
  then have "rs = []"
    by (rule rsizes_eq_0_imp_Nil)
  then show ?thesis
    using RALTS by simp
next
  case (RSTAR r)
  then show ?thesis
    using assms size_geq1[of r] by simp
