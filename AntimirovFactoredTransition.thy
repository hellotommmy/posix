      using RSTAR.prems by simp
  next
    case False
    then have q_sub: "q \<in> rsubterms r"
      using RSTAR.prems by simp
    show ?thesis
      by (rule RSTAR.hyps[OF _ _ q_sub])
        (use RSTAR.prems in simp_all)
  qed
next
  case (RNTIMES r n)
  show ?case
  proof (cases "q = RNTIMES r n")
    case True
