proof (intro conjI)
  let ?rows = "rpders_strong_dcanon1_rows_raw r (c # s)"
  let ?B = "6 * (rsize r + 3) ^ 3"
  have contract:
      "RLS (set ?rows) = Ders (c # s) (RL r) \<and>
