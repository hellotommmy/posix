lemma raw_shared_prune_active_suffix_closure_can_introduce_fresh_key:
  defines "a \<equiv> RCHAR (CHR ''a'')"
  defines "b \<equiv> RCHAR (CHR ''b'')"
  defines "c \<equiv> RCHAR (CHR ''c'')"
  defines "inner \<equiv> RSEQ (RALTS [a]) b"
  defines "earlier \<equiv> RSEQ (RALTS []) c"
  defines "later \<equiv> RSEQ (RALTS [inner]) c"
  defines "U \<equiv> {earlier, later}"
  defines "fresh \<equiv> RSEQ b c"
  shows "fresh \<in> raw_shared_prune_active_suffix_keys
      (raw_shared_prune_active_suffix_closure U)"
    and "fresh \<notin> raw_shared_prune_active_suffix_keys U"
proof -
  let ?row = "RSEQ (RALTS [a]) fresh"
  have pair: "(earlier, later) \<in> raw_shared_prune_active_suffix_pairs U"
    by (simp add: U_def earlier_def later_def
        raw_shared_prune_active_suffix_pairs_def
        raw_shared_prune_suffix_key_def)
  have out_row: "?row \<in> raw_shared_prune_pair_outputs earlier later"
    by (simp add: a_def b_def c_def inner_def earlier_def later_def fresh_def
        raw_shared_prune_pair_outputs_def rsimpStrong_prune_pair_raw_def
        rsimp7_SEQ_atom_def)
  have row_in_closure: "?row \<in> raw_shared_prune_active_suffix_closure U"
    using pair out_row
    by (auto simp add: raw_shared_prune_active_suffix_closure_as_pairs
        split: prod.splits)
  have key: "raw_shared_prune_suffix_key ?row = Some fresh"
    by (simp add: raw_shared_prune_suffix_key_def)
  have "Some fresh \<in> raw_shared_prune_suffix_key `
      raw_shared_prune_active_suffix_closure U"
  proof (rule image_eqI)
    show "Some fresh = raw_shared_prune_suffix_key ?row"
      using key by simp
    show "?row \<in> raw_shared_prune_active_suffix_closure U"
      by (rule row_in_closure)
  qed
  then show "fresh \<in> raw_shared_prune_active_suffix_keys
      (raw_shared_prune_active_suffix_closure U)"
    by (simp add: raw_shared_prune_active_suffix_keys_def)
  show "fresh \<notin> raw_shared_prune_active_suffix_keys U"
    by (simp add: U_def earlier_def later_def fresh_def
        raw_shared_prune_active_suffix_keys_def
        raw_shared_prune_suffix_key_def)
qed

lemma card_raw_shared_prune_same_suffix_pairs_le_sum_buckets:
  assumes finite: "finite U"
  shows "card (raw_shared_prune_same_suffix_pairs U) \<le>
    (\<Sum>k\<in>raw_shared_prune_suffix_key ` U.
      card (raw_shared_prune_suffix_bucket U k) *
      card (raw_shared_prune_suffix_bucket U k))"
proof -
  let ?keys = "raw_shared_prune_suffix_key ` U"
  have keys_finite: "finite ?keys"
    using finite by simp
  have "card (raw_shared_prune_same_suffix_pairs U) =
      card (\<Union>k\<in>?keys.
        raw_shared_prune_suffix_bucket U k \<times>
        raw_shared_prune_suffix_bucket U k)"
    by (simp add: raw_shared_prune_same_suffix_pairs_bucket_union)
  also have "... \<le> (\<Sum>k\<in>?keys.
      card (raw_shared_prune_suffix_bucket U k \<times>
        raw_shared_prune_suffix_bucket U k))"
    by (rule card_UN_le[OF keys_finite])
  also have "... =
      (\<Sum>k\<in>?keys.
        card (raw_shared_prune_suffix_bucket U k) *
        card (raw_shared_prune_suffix_bucket U k))"
    by (rule sum.cong) (use finite in auto)
  finally show ?thesis .
qed

lemma card_raw_shared_prune_same_suffix_pairs_bucket_bound:
  assumes finite: "finite U"
    and keys_bound: "card (raw_shared_prune_suffix_key ` U) \<le> S"
    and bucket_bound: "\<And>k. k \<in> raw_shared_prune_suffix_key ` U \<Longrightarrow>
      card (raw_shared_prune_suffix_bucket U k) \<le> K"
  shows "card (raw_shared_prune_same_suffix_pairs U) \<le> S * K * K"
proof -
  let ?keys = "raw_shared_prune_suffix_key ` U"
  have pair_sum:
    "card (raw_shared_prune_same_suffix_pairs U) \<le>
      (\<Sum>k\<in>?keys.
        card (raw_shared_prune_suffix_bucket U k) *
        card (raw_shared_prune_suffix_bucket U k))"
    by (rule card_raw_shared_prune_same_suffix_pairs_le_sum_buckets[OF finite])
  have "(\<Sum>k\<in>?keys.
        card (raw_shared_prune_suffix_bucket U k) *
        card (raw_shared_prune_suffix_bucket U k))
      \<le> (\<Sum>k\<in>?keys. K * K)"
  proof (rule sum_mono)
    fix k
    assume k: "k \<in> ?keys"
    have bucket_le: "card (raw_shared_prune_suffix_bucket U k) \<le> K"
      by (rule bucket_bound[OF k])
    show "card (raw_shared_prune_suffix_bucket U k) *
        card (raw_shared_prune_suffix_bucket U k) \<le> K * K"
      by (rule mult_mono[OF bucket_le bucket_le]) simp_all
  qed
  also have "... = card ?keys * (K * K)"
    by simp
  also have "... \<le> S * (K * K)"
    by (rule mult_right_mono[OF keys_bound]) simp
  finally have
    "(\<Sum>k\<in>?keys.
        card (raw_shared_prune_suffix_bucket U k) *
        card (raw_shared_prune_suffix_bucket U k)) \<le> S * (K * K)" .
  then have "card (raw_shared_prune_same_suffix_pairs U) \<le> S * (K * K)"
    using pair_sum by linarith
  then show ?thesis
    by simp
qed

