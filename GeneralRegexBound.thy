      rsize x \<le> Suc (rsize (RSEQ r1 r2) + rsize (RSEQ r1 r2))"
    and right: "\<And>x. x \<in> rpath9_atom_frontiers r2 \<Longrightarrow>
      rsize x \<le> Suc (rsize r2 + rsize r2)"
