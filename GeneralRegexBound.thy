  qed
  have elem_alt: "p \<in> rsubterms (RALTS rows)"
    using p_union by simp
  have elem_sub: "p \<in> rsubterms (RSEQ (RALTS rows) k)"
  proof -
    have "p \<in> rsubterms (RALTS rows) \<union> rsubterms k"
      using elem_alt by blast
    then show ?thesis
