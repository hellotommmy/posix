lemma RL_rders_pder:
  assumes "legacy_rrexp r"
  shows "RL (rders_pder r s) = Ders s (RL r)"
  using assms
proof (induct s arbitrary: r)
  case Nil
  then show ?case by (simp add: Ders_def)
next
  case (Cons c s)
  have next_legacy: "legacy_rrexp (rpd_der c r)"
