  show "raw_shared_prune_same_suffix_closure U \<subseteq> U"
  proof (rule raw_shared_prune_same_suffix_closure_subsetI)
    fix q
    assume "q \<in> U"
    then show "set (rflts [q]) \<subseteq> U"
      by (rule flat_closed)
  next
    show "raw_shared_prune_closed U"
      by (rule closed)
