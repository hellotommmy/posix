lemma rpders_strong_rows_subsetI:
  assumes init: "set rs \<subseteq> U"
      and step: "\<And>xs c. set xs \<subseteq> U \<Longrightarrow>
        set (rpder_strong_rows c xs) \<subseteq> U"
  shows "set (rpders_strong_rows rs s) \<subseteq> U"
