  case (RSEQ k1 k2)
  then show ?case by simp
next
  case (RALTS rs)
  have "rpath9_tail (RALTS rs) = rsimp7_SEQ_atom (rsimp9 (RALTS rs)) RONE"
    by simp
  also have "... = rsimp9 (RALTS rs)"
