lemma card_raw_final_active_suffix_row_dag_universe_decomp:
  "card (raw_final_active_suffix_row_dag_universe r) \<le>
    card (raw_final_active_suffix_rows r) +
    card (raw_final_active_suffix_alt_nodes r) +
    card (raw_final_active_suffix_payload_dag_universe r) +
    card (raw_final_active_suffix_key_dag_universe r)"
proof -
  let ?Rows = "raw_final_active_suffix_rows r"
  let ?Alts = "raw_final_active_suffix_alt_nodes r"
  let ?Payload = "raw_final_active_suffix_payload_dag_universe r"
  let ?Keys = "raw_final_active_suffix_key_dag_universe r"
  let ?Parts = "?Rows \<union> ?Alts \<union> ?Payload \<union> ?Keys"
  have "card (raw_final_active_suffix_row_dag_universe r) \<le> card ?Parts"
    by (rule card_mono)
      (simp_all add: raw_final_active_suffix_row_dag_universe_decomp_subset)
  also have "card ?Parts \<le>
      card ?Rows + card ?Alts + card ?Payload + card ?Keys"
  proof -
    have a: "card ?Parts \<le> card (?Rows \<union> ?Alts \<union> ?Payload) +
        card ?Keys"
      by (rule card_Un_le)
    have b: "card (?Rows \<union> ?Alts \<union> ?Payload) \<le>
        card (?Rows \<union> ?Alts) + card ?Payload"
      by (rule card_Un_le)
    have c: "card (?Rows \<union> ?Alts) \<le> card ?Rows + card ?Alts"
      by (rule card_Un_le)
    show ?thesis
      using a b c by linarith
  qed
  finally show ?thesis .
qed

