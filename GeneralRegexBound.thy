  have inner: "good (rsimp4_SEQ_atom r1' r2) \<or>
      rsimp4_SEQ_atom r1' r2 = RZERO"
    by (rule RSEQ.hyps(2)) (use good_mid RSEQ.prems in auto)
  show ?case
    by (simp add: RSEQ.hyps(1)[OF disjI1[OF good_left] inner])
