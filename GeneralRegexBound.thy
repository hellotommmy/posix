lemma rpath9_tight_member_budget_RSEQ_boundI:
  assumes left: "rpath9_tight_member_budget r1 (RSEQ r2 k) \<le> N"
    and right: "rpath9_tight_member_budget r2 k \<le> N"
  shows "rpath9_tight_member_budget (RSEQ r1 r2) k \<le> N"
