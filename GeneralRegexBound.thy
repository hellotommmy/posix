    then show ?thesis
      using RALTS.prems by simp
  next
    case (RSTAR r)
    then show ?thesis
      using RALTS.prems by simp
  next
    case (RNTIMES r n)
    then show ?thesis
      using RALTS.prems by simp
  next
    case (RBACKREF4 a b c d cs)
    then show ?thesis
      using RALTS.prems by simp
  next
    case (RHALF r cs rep)
    then show ?thesis
      using RALTS.prems by simp
  next
