lemma rpath9_tight_member_budget_RALTS_boundI:
  assumes "\<And>q. q \<in> set rs \<Longrightarrow>
    rpath9_tight_member_budget q k \<le> N"
  shows "rpath9_tight_member_budget (RALTS rs) k \<le> N"
