    (rsimp_ALTs (rdistinct (rflts (rsimp4_seq_row (RNTIMES r n) k)) {}))"
    using assms RNTIMES by (simp add: rsimp4_SEQ_def)
  then have "rsize q \<le> rsize k + (rsize (RNTIMES r n) + 2)\<^sup>2"
