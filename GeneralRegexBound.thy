  then show ?thesis
    using assms by (simp add: rsimp4_SEQ_def)
next
  case (RSTAR r)
  then show ?thesis
    using assms by (simp add: rsimp4_SEQ_def)
next
  case (RNTIMES r n)
  then show ?thesis
    using assms by (simp add: rsimp4_SEQ_def)
next
  case (RBACKREF4 r1 r2 r3 r4 cs)
  then show ?thesis
    using assms by (simp add: rsimp4_SEQ_def)
