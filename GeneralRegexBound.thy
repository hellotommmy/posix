    and pruned: "rpder_strong_rows_clean_absorbed_pruned c rs rows"
  shows "RLS (set rows) = Der c (RLS (set rs))"
proof -
  obtain mid where absorbed:
      "rpder_strong_rows_clean_absorbed c rs mid"
