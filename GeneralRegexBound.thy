  also have "... \<le> sum_list (map (\<lambda>r. (rsize r + 2)\<^sup>2) rs)"
    using assms by (simp add: sum_list_mono)
  also have "... \<le> (rsizes rs + 3)\<^sup>2"
    by (rule sum_list_rsize_plus2_square_le_rsizes_plus3_square)
