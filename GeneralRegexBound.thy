lemma card_rpath9_atom_frontiers_RALTS_quadraticI:
  assumes "\<And>q. q \<in> set rs \<Longrightarrow>
    card (rpath9_atom_frontiers q) \<le> (rsize q + 2)\<^sup>2"
  shows "card (rpath9_atom_frontiers (RALTS rs)) \<le>
